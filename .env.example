# ============================================================
# Performance System
# Configuracion de ejemplo
# ============================================================
#
# Copiar este archivo como .env y completar los valores
# correspondientes al entorno.
#
# NO guardar credenciales reales en Git.


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=performance_system
DB_USER=perf_user
DB_PASSWORD=CHANGE_ME


# ------------------------------------------------------------
# Flask / sesion
# ------------------------------------------------------------

FLASK_SECRET_KEY=CHANGE_ME
FLASK_DEBUG=0

# En desarrollo HTTP debe permanecer en 0.
# En produccion HTTPS debe configurarse en 1.
SESSION_COOKIE_SECURE=0

# Maximo permitido para la peticion HTTP de subida.
# Default actual: 12 MiB.
MAX_UPLOAD_REQUEST_BYTES=12582912


# ------------------------------------------------------------
# Google OAuth
# ------------------------------------------------------------

GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# Desarrollo local:
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback

GOOGLE_SCOPES=openid email profile

# Completar con el formato esperado por la configuracion
# institucional de Performance System.
ALLOWED_DOMAIN_INF=CHANGE_ME
ALLOWED_DOMAIN_UDEC=CHANGE_ME

OAUTH_HTTP_TIMEOUT_SECONDS=10
OAUTH_STATE_MAX_AGE_SECONDS=600


# ------------------------------------------------------------
# Frontend / CORS
# ------------------------------------------------------------

# Desarrollo:
FRONTEND_LOGIN_URL=http://localhost:3000/login

# Origenes permitidos separados por coma.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000


# ------------------------------------------------------------
# Coordinador / nodo de ejecucion
# ------------------------------------------------------------

EXECUTION_MODE=local

MASTER_HOST=127.0.0.1
MASTER_SEND_PORT=50000
MASTER_RESULT_PORT=60000

SLAVE_MODE=local
SLAVE_TIMEOUT=1000

COMPILE_TIMEOUT_SECONDS=30
MASTER_EXECUTION_TIMEOUT_SECONDS=2000

QUEUE_POLL_SECONDS=10
QUEUE_RECENT_SECONDS=300
EXECUTION_HEARTBEAT_SECONDS=10


# ------------------------------------------------------------
# Ejecucion remota
# ------------------------------------------------------------
#
# Solo necesarios si posteriormente se utiliza un modo remoto.
# No se incluyen aqui usuarios, hosts ni rutas institucionales
# concretas para evitar acoplar el repositorio a un servidor.

# REMOTE_SSH_TARGET=
# REMOTE_STATUS_DIR=
REMOTE_SSH_TIMEOUT_SECONDS=15


# ------------------------------------------------------------
# Recuperacion de ejecuciones
# ------------------------------------------------------------

RECOVERY_WATCHDOG_INTERVAL_SECONDS=30
RECOVERY_ACTIVE_STALE_SECONDS=90
RECOVERY_QUEUED_STALE_SECONDS=1800
RECOVERY_WATCHDOG_LOCK_KEY=74040101


# ------------------------------------------------------------
# Estados/runtime
# ------------------------------------------------------------

STATUS_AUTO_CLEANUP_ENABLED=0
STATUS_RETENTION_LIMIT=50


# ------------------------------------------------------------
# Herramientas de medicion
# ------------------------------------------------------------

PERF_BIN=perf


# ------------------------------------------------------------
# Explicaciones asistidas por IA
# ------------------------------------------------------------
#
# Configuracion opcional asociada a esa funcionalidad.
# No incluir una clave real en el repositorio.

# OPENAI_API_KEY=
# PERFORMANCE_AI_MODEL=
